				"type": "String"
			},
			{
				"name": "ContactName",
				"type": "String"
			},
			{
				"name": "Email",
				"type": "String"
			},
			{
				"name": "Phone",
				"type": "String"
			},
			{
				"name": "BillingAddress",
				"type": "String"
			},
			{
				"name": "City",
				"type": "String"
			},
			{
				"name": "State",
				"type": "String"
			},
			{
				"name": "ZipCode",
				"type": "String"
			},
			{
				"name": "Country",
				"type": "String"
			},
			{
				"name": "AccountType",
				"type": "String"
			},
			{
				"name": "CreditLimit",
				"type": "String"
			},
			{
				"name": "AccountStatus",
				"type": "String"
			}
		]
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}