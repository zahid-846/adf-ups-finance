			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": "customer_accounts.csv",
				"folderPath": "customers/raw",
				"container": "ups-finance-source"
			},
			"columnDelimiter": ",",
			"rowDelimiter": "\n",
			"encodingName": "UTF-8",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
