{
	"name": "DS_CSV_CustomerAccounts_Source",
	"properties": {
		"description": "Source dataset for UPS Customer Accounts CSV file",
		"linkedServiceName": {
			"referenceName": "LS_AzureBlobStorage_Source",
			"type": "LinkedServiceReference"
		},
		"annotations": [
			"UPS",
			"Customer",
			"Source",
			"CSV"
		],
		"type": "DelimitedText",
