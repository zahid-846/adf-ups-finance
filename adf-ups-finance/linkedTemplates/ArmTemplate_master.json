{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-ups-finance"
		},
		"LS_AzureBlobStorage_Sink_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_AzureBlobStorage_Sink'"
		},
		"LS_AzureBlobStorage_Source_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_AzureBlobStorage_Source'"
		},
		"TR_UPS_Finance_Daily_Schedule_properties_PL_UPS_Finance_Master_parameters_BillingMonth": {
			"type": "string",
			"defaultValue": "@formatDateTime(addDays(trigger().scheduledTime, -1), 'MM')"
		},
		"TR_UPS_Finance_Daily_Schedule_properties_PL_UPS_Finance_Master_parameters_BillingYear": {
			"type": "string",
			"defaultValue": "@formatDateTime(addDays(trigger().scheduledTime, -1), 'yyyy')"
		},
		"TR_UPS_Finance_Daily_Schedule_properties_PL_UPS_Finance_Master_parameters_ProcessingDate": {
			"type": "string",
			"defaultValue": "@formatDateTime(addDays(trigger().scheduledTime, -1), 'yyyy-MM-dd')"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-ups-finance_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureBlobStorage_Sink_connectionString": {
						"value": "[parameters('LS_AzureBlobStorage_Sink_connectionString')]"
					},
					"LS_AzureBlobStorage_Source_connectionString": {
						"value": "[parameters('LS_AzureBlobStorage_Source_connectionString')]"
					},
					"TR_UPS_Finance_Daily_Schedule_properties_PL_UPS_Finance_Master_parameters_BillingMonth": {
						"value": "[parameters('TR_UPS_Finance_Daily_Schedule_properties_PL_UPS_Finance_Master_parameters_BillingMonth')]"
					},
					"TR_UPS_Finance_Daily_Schedule_properties_PL_UPS_Finance_Master_parameters_BillingYear": {
						"value": "[parameters('TR_UPS_Finance_Daily_Schedule_properties_PL_UPS_Finance_Master_parameters_BillingYear')]"
					},
					"TR_UPS_Finance_Daily_Schedule_properties_PL_UPS_Finance_Master_parameters_ProcessingDate": {
						"value": "[parameters('TR_UPS_Finance_Daily_Schedule_properties_PL_UPS_Finance_Master_parameters_ProcessingDate')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}