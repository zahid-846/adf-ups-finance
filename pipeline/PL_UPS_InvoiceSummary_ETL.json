{
	"name": "PL_UPS_InvoiceSummary_ETL",
	"properties": {
		"description": "End-to-end ETL pipeline for UPS Finance Invoice Summary. Reads raw invoice CSV, applies aging classification and aggregation via data flow, and sinks customer billing summary to output CSV.",
		"activities": [
			{
				"name": "ValidateInvoiceFileExists",
				"description": "Check that source invoice_summary.csv exists before processing",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 1,
					"retryIntervalInSeconds": 30
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_CSV_InvoiceSummary_Source",
						"type": "DatasetReference"
					},
					"fieldList": [
						"exists",
						"size",
						"lastModified"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": false
					}
				}
			},
			{
				"name": "CheckInvoiceFileExists",
				"description": "Branch on whether invoice file exists",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "ValidateInvoiceFileExists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@activity('ValidateInvoiceFileExists').output.exists",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "LogInvoiceFileMissing",
							"description": "Fail the pipeline if invoice source file not found",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('Source file invoice_summary.csv was not found. Pipeline run ID: ', pipeline().RunId)",
									"type": "Expression"
								},
								"errorCode": "INVOICE_FILE_NOT_FOUND"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "RunInvoiceTransformDataFlow",
							"description": "Execute the invoice summary mapping data flow",
							"type": "ExecuteDataFlow",
							"dependsOn": [],
							"policy": {
								"timeout": "1.00:00:00",
								"retry": 1,
								"retryIntervalInSeconds": 60
							},
							"userProperties": [],
							"typeProperties": {
								"dataflow": {
									"referenceName": "DF_InvoiceSummary_Transform",
									"type": "DataFlowReference"
								},
								"compute": {
									"coreCount": 8,
									"computeType": "General"
								},
								"traceLevel": "Fine"
							}
						}
					]
				}
			},
			{
				"name": "SetSuccessStatus",
				"description": "Record pipeline completion status",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "CheckInvoiceFileExists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "PipelineStatus",
					"value": {
						"value": "@concat('SUCCESS | RunId: ', pipeline().RunId, ' | Completed: ', utcNow())",
						"type": "Expression"
					}
				}
			}
		],
		"concurrency": 1,
		"parameters": {
			"ProcessingDate": {
				"type": "String"
			}
		},
		"variables": {
			"PipelineStatus": {
				"type": "String",
				"defaultValue": "RUNNING"
			}
		},
		"annotations": [
			"UPS",
			"Finance",
			"Invoice",
			"ETL",
			"CSV"
		],
		"lastPublishTime": "2026-06-03T15:23:41Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}